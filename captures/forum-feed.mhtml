.glp_notify_item { display: flex; align-items: stretch; justify-content: sp=
ace-between; border-top: 1px solid rgb(230, 230, 230); }

.glp_notify_item:hover { background: rgb(243, 246, 250); }

.glp_notify_link, .glp_notify_link:visited { display: block; flex: 1 1 0%; =
padding: 8px 10px; text-decoration: none; color: inherit; }

.glp_notify_clear { width: 32px; display: flex; align-items: center; justif=
y-content: center; text-decoration: none; color: inherit; opacity: 0.65; bo=
rder-left: 1px solid rgba(0, 0, 0, 0.08); }

.glp_notify_clear:hover { opacity: 1; background: rgba(30, 92, 153, 0.12); =
}

.glp_notify_row { display: flex; align-items: center; justify-content: spac=
e-between; gap: 8px; }

.glp_notify_meta { display: inline-block; padding: 1px 6px; border-radius: =
999px; font-size: 7pt; line-height: 1.2; border: 1px solid rgb(200, 215, 23=
0); background: rgb(234, 242, 255); color: rgb(30, 92, 153); }

.glp_notify_title { display: block; margin-top: 2px; font-weight: bold; }

.glp_notify_count { display: inline-block; margin-left: 6px; padding: 0px 6=
px; border-radius: 10px; background: rgb(30, 92, 153); color: rgb(255, 255,=
 255); font-weight: bold; font-size: 8pt; }

.glp_notify_empty { padding: 12px 10px; color: rgb(85, 85, 85); }

.glp_notify_foot { padding: 6px 10px; border-top: 1px solid rgb(230, 230, 2=
30); background: rgb(250, 250, 250); text-align: right; }

@media screen and (min-width: 701px) {
  .glp_notify_switch { margin-bottom: 6px; }
}
